<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Letra200bSharp.Avalonia.ViewModels"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:res="using:Letra200bSharp.Avalonia.Resources"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="400"
             x:Class="Letra200bSharp.Avalonia.Views.QrTabView"
             x:DataType="vm:QrTabViewModel">
    <Grid RowDefinitions="*,Auto" Margin="8">
        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.QrTab_DataLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding Data}" PlaceholderText="{x:Static res:Strings.QrTab_DataPlaceholder}" AcceptsReturn="True" MaxLength="2000" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{x:Static res:Strings.QrTab_SymbologyLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Symbologies}" SelectedItem="{Binding SelectedSymbology}" Width="180" />
                </StackPanel>

                <!-- What LetraHelper actually resolved the data to: symbol name, dots per module
                     on each axis, and the resulting physical module size - plus a warning when
                     that size is at/below the practical scanning limit (~0.16 mm). -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasSymbolInfo}">
                    <TextBlock Text="⚠" Foreground="Orange" VerticalAlignment="Center"
                               IsVisible="{Binding MayNotScanWell}"
                               ToolTip.Tip="{x:Static res:Strings.QrTab_MayNotScanWarning}" />
                    <TextBlock Text="{Binding SymbolInfoText}" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Fixed height matching LetraHelper.PreviewImage's baked-in nearest-neighbor
                     upscale (32 * PreviewScale), so the label stays crisp instead of blurring when
                     stretched; only the (possibly long) length axis scrolls. -->
                <Border BorderBrush="Gray" BorderThickness="1" Background="White" Margin="0,10,0,0" Height="136">
                    <suki:BusyArea IsBusy="{Binding IsPreviewLoading}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Image Source="{Binding PreviewBitmap}" Stretch="None" VerticalAlignment="Center" Margin="4" />
                        </ScrollViewer>
                    </suki:BusyArea>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.Common_Preview}" Command="{Binding PreviewCommand}" />
            <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" />
            <Button Content="{x:Static res:Strings.Common_Concatenate}" Command="{Binding ConcatenateCommand}" ToolTip.Tip="{x:Static res:Strings.Common_ConcatenateTooltip}" />
            <Button Content="{x:Static res:Strings.Common_Print}" Command="{Binding PrintCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </Grid>
</UserControl>
