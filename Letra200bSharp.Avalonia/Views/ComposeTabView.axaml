<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Letra200bSharp.Avalonia.ViewModels"
             xmlns:services="using:Letra200bSharp.Avalonia.Services"
             xmlns:conv="using:Letra200bSharp.Avalonia.Converters"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:res="using:Letra200bSharp.Avalonia.Resources"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="480"
             x:Class="Letra200bSharp.Avalonia.Views.ComposeTabView"
             x:Name="Root"
             x:DataType="vm:ComposeTabViewModel">
    <Grid RowDefinitions="*,Auto" Margin="8">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.ComposeTab_NoElementsYet}"
                           IsVisible="{Binding !HasElements}"
                           TextWrapping="Wrap" Opacity="0.6" HorizontalAlignment="Center" Margin="0,20" />

                <!-- Staged elements, in print order - added here via "Concatenate" on the Text/
                     Barcode/2D Code/Draw tabs, not edited in this tab. Same drag-handle reorder
                     pattern as DIN Rail's row list. -->
                <ListBox x:Name="ElementsList" ItemsSource="{Binding Elements}" IsVisible="{Binding HasElements}" DragDrop.AllowDrop="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:ComposeElement">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="⠿" Cursor="SizeAll" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"
                                           PointerPressed="OnDragHandlePointerPressed"
                                           ToolTip.Tip="{x:Static res:Strings.ComposeTab_DragHandleTooltip}" />
                                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="White" Width="60" Height="30">
                                    <Image Stretch="Uniform" Margin="2"
                                           Source="{Binding ThumbnailPng, Converter={x:Static conv:ByteArrayToBitmapConverter.Instance}}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="3" Content="{x:Static res:Strings.ComposeTab_RemoveButton}"
                                        Command="{Binding #Root.((vm:ComposeTabViewModel)DataContext).RemoveElementCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="{x:Static res:Strings.ComposeTab_ClearAllButton}" Command="{Binding ClearAllCommand}" HorizontalAlignment="Left" IsEnabled="{Binding HasElements}" />

                <!-- Fixed height matching LetraHelper.PreviewImage's baked-in nearest-neighbor
                     upscale (32 * PreviewScale), so the label stays crisp instead of blurring when
                     stretched; only the (possibly long) length axis scrolls. -->
                <Border BorderBrush="Gray" BorderThickness="1" Background="White" Height="136">
                    <suki:BusyArea IsBusy="{Binding IsPreviewLoading}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Image Source="{Binding PreviewBitmap}" Stretch="None" VerticalAlignment="Center" Margin="4" />
                        </ScrollViewer>
                    </suki:BusyArea>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.Common_Preview}" Command="{Binding PreviewCommand}" />
            <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" />
            <Button Content="{x:Static res:Strings.Common_Print}" Command="{Binding PrintCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </Grid>
</UserControl>
