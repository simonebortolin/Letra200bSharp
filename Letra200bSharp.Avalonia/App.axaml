<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Letra200bSharp.Avalonia"
             xmlns:cascadia="https://github.com/simonebortolin/CascadiaUI"
             x:Class="Letra200bSharp.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- Avalonia Cascadia Theme (includes Fluent): follows the OS light/dark setting by
             itself, comfortable density for touch on Android. -->
        <cascadia:CascadiaTheme />
    </Application.Styles>
</Application>