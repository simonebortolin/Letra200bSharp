<Project>
  <PropertyGroup>
    <!-- The release version: bump this, and merging to main tags and publishes vX.Y.Z.
         CI passes a pre-release VersionSuffix for pull request builds (pr.12.34 -> 1.4.0-pr.12.34). -->
    <VersionPrefix>1.4.0</VersionPrefix>
	<EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Composed here rather than left to the SDK: the SDK only derives Version in its .targets,
         after project bodies are evaluated, and the Android csproj reads $(Version) in its body. -->
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Android versionCode: must be a positive integer that strictly increases between
         releases. Derived from VersionPrefix (never Version, which may carry a pre-release
         suffix like "-pr.12.34"), so bumping <VersionPrefix> above is the only edit needed.
         A pre-release shares its release's versionCode, so the final release still installs
         over it. Assumes Minor and Patch each stay below 100. -->
    <_VersionMajor>$(VersionPrefix.Split('.')[0])</_VersionMajor>
    <_VersionMinor>$(VersionPrefix.Split('.')[1])</_VersionMinor>
    <_VersionPatch>$(VersionPrefix.Split('.')[2])</_VersionPatch>
    <AndroidVersionCode>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_VersionMajor), 10000)), $([MSBuild]::Multiply($(_VersionMinor), 100)))), $(_VersionPatch)))</AndroidVersionCode>
  </PropertyGroup>
</Project>
