<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- letra200bsharp -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <!-- Keep in step with SkiaSharp: its package doesn't pull the Linux natives (see the desktop project). -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageVersion Include="InTheHand.BluetoothLE" Version="4.0.45" />
    <!-- InTheHand.BluetoothLE's Linux backend (Linux.Bluetooth) pulls a vulnerable
         Tmds.DBus 0.15.0 (GHSA-xrw6-gwf8-vvr9, fixed in 0.92.0); pin it directly. -->
    <PackageVersion Include="Tmds.DBus" Version="0.95.1" />
    <PackageVersion Include="CodeGlyphX" Version="2.1.0" />

    <!-- letra200bsharp.Avalonia -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CascadiaUI" Version="0.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- letra200bsharp.Avalonia.Android -->
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <!-- AndroidX Core 1.19 (pulled in by SplashScreen via AppCompatResources) merged the
         core-ktx classes into core; an older transitive Core.Core.Ktx (from Avalonia.Android)
         then duplicates them and D8 fails. Pin core-ktx to the matching 1.19 stub. -->
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />

    <!-- letra200bsharp.Avalonia.Desktop -->
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
  </ItemGroup>
</Project>
