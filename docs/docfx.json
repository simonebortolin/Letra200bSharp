{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../Letra200bSharp.200b/bin/Release/net10.0",
          "files": [
            "Letra200bSharp.dll",
            "Letra200bSharp.200b.dll"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "flattened",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Letra200bSharp",
      "_appTitle": "Letra200bSharp",
      "_appFooter": "Letra200bSharp - MIT licensed",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/simonebortolin/Letra200bSharp",
        "branch": "main"
      }
    }
  }
}
