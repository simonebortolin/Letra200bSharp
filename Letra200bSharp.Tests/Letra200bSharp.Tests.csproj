<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plural, even with a single target, so CI's -p:TargetFrameworks=... override doesn't skip the packages' build props. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <!-- net10.0 only: the driver's Windows/Android targets need their platform to run. -->
    <ProjectReference Include="..\Letra200bSharp.200b\Letra200bSharp.200b.csproj" SetTargetFramework="TargetFramework=net10.0" />
    <!-- For the app's history/composition compatibility tests. -->
    <ProjectReference Include="..\Letra200bSharp.Avalonia\Letra200bSharp.Avalonia.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
