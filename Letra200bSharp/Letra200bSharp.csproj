<Project Sdk="Microsoft.NET.Sdk">

  <!-- Printer-agnostic core: the label model, the driver contract every printer implements,
       and the AddLetra() builder/entrypoint. No rendering engine or transport lives here -
       those come with each driver package (see Letra200bSharp.200b). -->
  <PropertyGroup>
    <!-- Plural, even with a single target, so CI's -p:TargetFrameworks=... override applies here too. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Self-explanatory members (enum values, simple properties) stay undocumented. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
