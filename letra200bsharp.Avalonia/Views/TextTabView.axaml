<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Letra200bSharp.Avalonia.ViewModels"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:res="using:Letra200bSharp.Avalonia.Resources"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="480"
             x:Class="Letra200bSharp.Avalonia.Views.TextTabView"
             x:DataType="vm:TextTabViewModel">
    <Grid RowDefinitions="*,Auto" Margin="8">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="10">
                <!-- Text Line 1 / Text Line 2 share one Grid (instead of one per row) so both
                     rows resolve the exact same Auto label-column width - two independent Grids
                     would let "Text:" (no second line) and "Text Line 1:"/"Text Line 2:" size
                     that column differently, leaving the text boxes out of alignment with
                     each other depending on which label happens to be showing. -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Line1Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Line1}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.TextTab_Line2Label}" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding Line2Enabled}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Line2}" IsVisible="{Binding Line2Enabled}" />
                </Grid>

                <!-- Each option below is wide enough that only one fits per row at phone width
                     (stacking one-per-line there, since squeezing several onto a row just made
                     each ComboBox harder to read/tap), while several fit side by side once
                     there's room - no separate mobile/desktop layout to keep in sync, it just
                     reflows with whatever width is actually available. -->
                <WrapPanel>
                    <Grid ColumnDefinitions="Auto,*" MinWidth="210" Margin="0,0,16,10">
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.TextTab_FontLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFontFamily}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" MinWidth="210" Margin="0,0,16,10">
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.TextTab_HeightLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" MinWidth="210" Margin="0,0,16,10">
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.TextTab_WidthLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <NumericUpDown Grid.Column="1" Value="{Binding WidthScale}" Minimum="0.5" Maximum="5" Increment="0.1" FormatString="0.0" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" MinWidth="210" Margin="0,0,16,10">
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.TextTab_StyleLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" MinWidth="210" Margin="0,0,16,10" IsEnabled="{Binding BoxStyleEnabled}">
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.TextTab_BoxLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BoxStyles}" SelectedItem="{Binding SelectedBoxStyle}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <CheckBox Content="{x:Static res:Strings.TextTab_UppercaseCheckbox}" IsChecked="{Binding UpperCase}" MinWidth="210" Margin="0,0,16,10" />
                </WrapPanel>

                <!-- Fixed height matching LetraHelper.PreviewImage's baked-in nearest-neighbor
                     upscale (32 * PreviewScale), so the label stays crisp instead of blurring when
                     stretched; only the (possibly long) length axis scrolls. -->
                <Border BorderBrush="Gray" BorderThickness="1" Background="White" Height="136">
                    <suki:BusyArea IsBusy="{Binding IsPreviewLoading}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Image Source="{Binding PreviewBitmap}" Stretch="None" VerticalAlignment="Center" Margin="4" />
                        </ScrollViewer>
                    </suki:BusyArea>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.Common_Preview}" Command="{Binding PreviewCommand}" />
            <Button Content="{x:Static res:Strings.Common_Print}" Command="{Binding PrintCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </Grid>
</UserControl>
