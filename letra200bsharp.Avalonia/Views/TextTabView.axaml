<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Letra200bSharp.Avalonia.ViewModels"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="480"
             x:Class="Letra200bSharp.Avalonia.Views.TextTabView"
             x:DataType="vm:TextTabViewModel">
    <Grid RowDefinitions="*,Auto" Margin="8">
        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding Line1Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding Line1}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0" IsVisible="{Binding Line2Enabled}">
                    <TextBlock Grid.Column="0" Text="Text Line 2:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding Line2}" />
                </Grid>

                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFontFamily}" Width="170" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Height:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" Width="65" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <NumericUpDown Value="{Binding WidthScale}" Minimum="0.5" Maximum="5" Increment="0.1" FormatString="0.0" Width="110" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <TextBlock Text="Style:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" Width="95" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6" IsEnabled="{Binding BoxStyleEnabled}">
                        <TextBlock Text="Box:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding BoxStyles}" SelectedItem="{Binding SelectedBoxStyle}" Width="95" />
                    </StackPanel>
                    <CheckBox Content="ALL UPPERCASE" IsChecked="{Binding UpperCase}" Margin="0,0,16,6" />
                </WrapPanel>

                <!-- Fixed height matching LetraHelper.PreviewImage's baked-in nearest-neighbor
                     upscale (32 * PreviewScale), so the label stays crisp instead of blurring when
                     stretched; only the (possibly long) length axis scrolls. -->
                <Border BorderBrush="Gray" BorderThickness="1" Background="White" Margin="0,10,0,0" Height="136">
                    <suki:BusyArea IsBusy="{Binding IsPreviewLoading}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Image Source="{Binding PreviewBitmap}" Stretch="None" VerticalAlignment="Center" Margin="4" />
                        </ScrollViewer>
                    </suki:BusyArea>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,0">
            <Button Content="Preview" Command="{Binding PreviewCommand}" />
            <Button Content="Print" Command="{Binding PrintCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </Grid>
</UserControl>
