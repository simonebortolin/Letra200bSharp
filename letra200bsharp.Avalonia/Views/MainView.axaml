<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Letra200bSharp.Avalonia.ViewModels"
             xmlns:views="using:Letra200bSharp.Avalonia.Views"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:res="using:Letra200bSharp.Avalonia.Resources"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Letra200bSharp.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <!-- SukiWindow (the desktop host - see MainWindow.axaml) draws this itself as part of
             its chrome, but the single-view Android host has no SukiWindow around MainView at
             all, so without hosting it here directly Android never gets SukiUI's themed
             (light/dark-aware) background - just whatever Avalonia's default is underneath. -->
        <suki:SukiBackground />

        <!-- TextElement.Foreground inherits down to every plain TextBlock in this view and in
             the tabs it hosts (see App.axaml for why that's needed), without overriding
             controls - like Buttons - that already set their own theme-aware Foreground. -->
        <Panel Margin="12" TextElement.Foreground="{DynamicResource AppTextBrush}">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.MainView_DevicesLabel}" FontWeight="Bold" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 Height="140">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="8,20,0,0">
                        <Button Content="{x:Static res:Strings.MainView_RefreshButton}"
                                Command="{Binding RefreshDevicesCommand}"
                                IsEnabled="{Binding !IsRefreshing}" />
                        <ToggleButton Content="🤓"
                                      IsChecked="{Binding IsStatsPanelVisible}"
                                      ToolTip.Tip="{x:Static res:Strings.MainView_StatsToggleButtonTooltip}" />
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                    <TabItem Header="{x:Static res:Strings.MainView_ImageTabHeader}">
                        <views:ImageTabView DataContext="{Binding Image}" />
                    </TabItem>
                    <TabItem Header="{x:Static res:Strings.MainView_TextTabHeader}">
                        <views:TextTabView DataContext="{Binding Text}" />
                    </TabItem>
                    <TabItem Header="{x:Static res:Strings.MainView_BarcodeTabHeader}">
                        <views:BarcodeTabView DataContext="{Binding Barcode}" />
                    </TabItem>
                    <TabItem Header="{x:Static res:Strings.MainView_HistoryTabHeader}">
                        <views:HistoryTabView DataContext="{Binding History}" />
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Placed directly in the shared MainView (rather than MainWindow.Hosts) so status
                 toasts (see MainViewModel.ReportStatus) work the same on both the desktop
                 SukiWindow and the single-view Android host. -->
            <suki:SukiToastHost Manager="{Binding ToastManager}" />

            <!-- YouTube-style "stats for nerds" overlay - raw protocol numbers for the last
                 print attempt (see MainViewModel.StatsDisplayText), toggled by the 🤓 button
                 above. Bottom-left so it never collides with the toast host. -->
            <Border IsVisible="{Binding IsStatsPanelVisible}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="16"
                    Padding="12,10"
                    CornerRadius="6"
                    Background="#CC000000"
                    BoxShadow="0 2 10 0 #40000000">
                <TextBlock Text="{Binding StatsDisplayText, TargetNullValue={x:Static res:Strings.MainView_StatsPanelNoDataYet}}"
                           FontFamily="Cascadia Code,Consolas,monospace"
                           FontSize="12"
                           Foreground="White"
                           TextWrapping="NoWrap" />
            </Border>
        </Panel>
    </Panel>
</UserControl>
