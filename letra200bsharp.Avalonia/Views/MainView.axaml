<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:letra200bsharp.Avalonia.ViewModels"
             xmlns:views="using:letra200bsharp.Avalonia.Views"
             xmlns:conv="using:letra200bsharp.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="letra200bsharp.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Devices:" FontWeight="Bold" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Devices}"
                         SelectedItem="{Binding SelectedDevice}"
                         Height="140">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Refresh"
                    VerticalAlignment="Top"
                    Margin="8,20,0,0"
                    Command="{Binding RefreshDevicesCommand}"
                    IsEnabled="{Binding !IsRefreshing}" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Image">
                <views:ImageTabView DataContext="{Binding Image}" />
            </TabItem>
            <TabItem Header="Text">
                <views:TextTabView DataContext="{Binding Text}" />
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{Binding IsStatusError, Converter={x:Static conv:BoolToStatusBrushConverter.Instance}}" />
    </Grid>
</UserControl>
