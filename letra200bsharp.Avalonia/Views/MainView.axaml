<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Letra200bSharp.Avalonia.ViewModels"
             xmlns:views="using:Letra200bSharp.Avalonia.Views"
             xmlns:conv="using:Letra200bSharp.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Letra200bSharp.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel Margin="12">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Devices:" FontWeight="Bold" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             Height="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        VerticalAlignment="Top"
                        Margin="8,20,0,0"
                        Command="{Binding RefreshDevicesCommand}"
                        IsEnabled="{Binding !IsRefreshing}" />
            </Grid>

            <TabControl Grid.Row="1">
                <TabItem Header="Image">
                    <views:ImageTabView DataContext="{Binding Image}" />
                </TabItem>
                <TabItem Header="Text">
                    <views:TextTabView DataContext="{Binding Text}" />
                </TabItem>
                <TabItem Header="Barcode">
                    <views:BarcodeTabView DataContext="{Binding Barcode}" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Toast: floats over the content instead of reserving layout space, and hides
             itself again after a few seconds (see MainViewModel.IsStatusVisible) instead
             of staying put forever. -->
        <Border IsVisible="{Binding IsStatusVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                Padding="14,10"
                MaxWidth="480"
                CornerRadius="8"
                Background="#E6323232"
                BoxShadow="0 2 10 0 #40000000">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{Binding IsStatusError, Converter={x:Static conv:BoolToStatusBrushConverter.Instance}}" />
        </Border>
    </Panel>
</UserControl>
